@model DisasterReport
@{
    var (cls, icon, label) = Model.Status switch
    {
        ReportStatus.Active => ("text-sky-300 border-sky-400/40 bg-sky-400/10", "ph-circle-dashed", "New"),
        ReportStatus.Verified => ("text-emerald-300 border-emerald-400/40 bg-emerald-400/10", "ph-seal-check", "Verified"),
        ReportStatus.Relayed => ("text-violet-300 border-violet-400/40 bg-violet-400/10", "ph-paper-plane-tilt", "Relayed"),
        ReportStatus.Resolved => ("text-emerald-300 border-emerald-400/40 bg-emerald-400/10", "ph-check-circle", "Resolved"),
        _ => ("text-slate-300 border-slate-400/40 bg-slate-400/10", "ph-archive", "Dismissed")
    };
}
<span class="inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-wide px-2 py-1 rounded-md border @cls">
    <i class="ph @icon text-sm" aria-hidden="true"></i>@label
</span>
