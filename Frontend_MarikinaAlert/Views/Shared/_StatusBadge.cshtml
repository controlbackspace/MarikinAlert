@model DisasterReport
@{
    var (dot, label) = Model.Status switch
    {
        ReportStatus.Active => ("bg-info", "New"),
        ReportStatus.Verified => ("bg-success", "Verified"),
        ReportStatus.Relayed => ("bg-primary", "Relayed"),
        ReportStatus.Resolved => ("bg-success", "Resolved"),
        _ => ("bg-muted", "Dismissed")
    };
}
<span class="inline-flex items-center gap-1.5 text-sm text-muted">
    <span class="w-2 h-2 rounded-full @dot" aria-hidden="true"></span>@label
</span>
