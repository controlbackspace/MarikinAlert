@inject IStringLocalizer<Translations> T
@{
    var here = Context.Request.Path + Context.Request.QueryString;
    var filipino = Translations.IsFilipino;
    string LangClass(bool active) => active ? "text-white underline underline-offset-4 decoration-2 decoration-accent" : "text-white/70 hover:text-white";
}
<!DOCTYPE html>
<html lang="@(filipino ? "fil" : "en")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#001845" />
    <meta name="description" content="Report fires, floods, collapses and medical emergencies in Marikina City, even without internet." />
    <title>@(ViewData["Title"] is string t ? $"{t} · MarikinAlert" : "MarikinAlert")</title>
    <partial name="_Assets" />
</head>
<body class="font-sans antialiased min-h-[100dvh] flex flex-col">

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 bg-white text-primary font-semibold px-4 py-2 rounded-md shadow">@T["Skip to form"]</a>

    <header class="bg-header text-white" style="padding-top: env(safe-area-inset-top)">
        <div class="max-w-xl mx-auto px-4 h-16 flex items-center gap-4">
            <a asp-controller="Reports" asp-action="Create" class="text-2xl font-bold tracking-tight mr-auto">MarikinAlert</a>

            <nav class="flex items-center gap-2.5 text-sm font-semibold" aria-label="Language">
                <a asp-controller="Reports" asp-action="Language" asp-route-lang="en" asp-route-returnUrl="@here"
                   class="@LangClass(!filipino) py-2" lang="en" aria-current="@(!filipino ? "true" : null)" title="English">EN</a>
                <span class="text-white/40" aria-hidden="true">|</span>
                <a asp-controller="Reports" asp-action="Language" asp-route-lang="fil" asp-route-returnUrl="@here"
                   class="@LangClass(filipino) py-2" lang="fil" aria-current="@(filipino ? "true" : null)" title="Filipino">FIL</a>
            </nav>

            <a asp-controller="Admin" asp-action="Login" class="text-sm font-semibold text-white/85 hover:text-white underline-offset-4 hover:underline py-2 -mr-1 pl-4 border-l border-white/20">
                @T["Dispatcher login"]
            </a>
        </div>
    </header>
    <div class="h-1 bg-accent" aria-hidden="true"></div>

    <main id="main" class="flex-1 w-full max-w-xl mx-auto px-4 pt-8 pb-12">
        @RenderBody()
    </main>

    <footer class="bg-surface border-t border-line" style="padding-bottom: env(safe-area-inset-bottom)">
        <div class="max-w-xl mx-auto px-4 py-5 text-sm text-muted space-y-2">
            <p>
                @Html.Raw(T["Can't use this form? Call {0} or {1}.",
                    "<a href=\"tel:161\" class=\"font-semibold text-primary underline underline-offset-2\">Marikina Rescue 161</a>",
                    "<a href=\"tel:911\" class=\"font-semibold text-primary underline underline-offset-2\">911</a>"].Value)
            </p>
            <p><a asp-controller="Reports" asp-action="Status" class="font-semibold text-primary underline underline-offset-2">@T["Check my report"]</a></p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
