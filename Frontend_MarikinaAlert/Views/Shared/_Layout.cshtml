<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#020617" />
    <title>@(ViewData["Title"] is string t ? $"{t} · MarikinAlert" : "MarikinAlert")</title>
    <partial name="_Assets" />
</head>
<body class="font-sans antialiased min-h-screen flex flex-col">

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] bg-emerald-500 text-ink font-bold px-4 py-2 rounded-lg">Skip to form</a>

    <header class="sticky top-0 z-50 bg-ink/90 backdrop-blur-md border-b border-white/5" style="padding-top: env(safe-area-inset-top)">
        <div class="max-w-xl mx-auto px-4 h-16 flex justify-between items-center">
            <a asp-controller="Reports" asp-action="Create" class="flex items-center gap-2.5">
                <span class="w-9 h-9 bg-emerald-500 rounded-xl grid place-items-center font-extrabold text-ink" aria-hidden="true">M</span>
                <span class="font-bold tracking-tight">MarikinAlert</span>
            </a>
            <a asp-controller="Admin" asp-action="Login" class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-slate-400 hover:text-white px-3 py-2 -mr-3 rounded-lg transition">
                <i class="ph ph-lock-simple text-base" aria-hidden="true"></i>
                Dispatcher
            </a>
        </div>
    </header>

    <main id="main" class="flex-1 w-full max-w-xl mx-auto px-4 pt-6 pb-10">
        @RenderBody()
    </main>

    <footer class="border-t border-white/5 bg-panel/60" style="padding-bottom: env(safe-area-inset-bottom)">
        <div class="max-w-xl mx-auto px-4 py-5 text-sm text-slate-400 flex items-center gap-3">
            <i class="ph-fill ph-phone-call text-xl text-emerald-400" aria-hidden="true"></i>
            <p>Can't use this form? Call <a href="tel:161" class="font-bold text-white underline underline-offset-2">Marikina Rescue 161</a> or <a href="tel:911" class="font-bold text-white underline underline-offset-2">911</a>.</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
