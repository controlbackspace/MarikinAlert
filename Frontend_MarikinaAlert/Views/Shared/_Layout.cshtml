<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#001845" />
    <meta name="description" content="Report fires, floods, collapses and medical emergencies in Marikina City, even without internet." />
    <title>@(ViewData["Title"] is string t ? $"{t} · MarikinAlert" : "MarikinAlert")</title>
    <partial name="_Assets" />
</head>
<body class="font-sans antialiased min-h-[100dvh] flex flex-col">

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 bg-white text-primary font-semibold px-4 py-2 rounded-md shadow">Skip to form</a>

    <header class="bg-header text-white" style="padding-top: env(safe-area-inset-top)">
        <div class="max-w-xl mx-auto px-4 h-16 flex justify-between items-center">
            <a asp-controller="Reports" asp-action="Create" class="flex items-center gap-2.5">
                <svg viewBox="0 0 32 32" class="w-8 h-8" aria-hidden="true"><rect width="32" height="32" rx="6" fill="#fff"/><path d="M8 23V9l8 8 8-8v14" fill="none" stroke="#0032a0" stroke-width="3.2" stroke-linejoin="round" stroke-linecap="round"/><rect x="6" y="26" width="20" height="2.5" rx="1" fill="#F77F00"/></svg>
                <span class="leading-tight">
                    <span class="block font-bold text-[17px] tracking-tight">MarikinAlert</span>
                    <span class="block text-xs text-white/75">Emergency reporting · Marikina City</span>
                </span>
            </a>
            <a asp-controller="Admin" asp-action="Login" class="text-sm font-semibold text-white/85 hover:text-white underline-offset-4 hover:underline px-2 py-2 -mr-2">
                Dispatcher login
            </a>
        </div>
    </header>
    <div class="h-1 bg-accent" aria-hidden="true"></div>

    <main id="main" class="flex-1 w-full max-w-xl mx-auto px-4 pt-8 pb-12">
        @RenderBody()
    </main>

    <footer class="bg-surface border-t border-line" style="padding-bottom: env(safe-area-inset-bottom)">
        <div class="max-w-xl mx-auto px-4 py-5 text-sm text-muted">
            <p>
                Can't use this form? Call
                <a href="tel:161" class="font-semibold text-primary underline underline-offset-2">Marikina Rescue 161</a>
                or <a href="tel:911" class="font-semibold text-primary underline underline-offset-2">911</a>.
            </p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
