@model DisasterReport
@{
    var (priorityClass, priorityLabel) = Model.Priority switch
    {
        ReportPriority.Critical => ("bg-danger text-white", "Critical"),
        ReportPriority.High => ("bg-accent text-ink", "High"),
        _ => ("bg-white text-muted border border-line", "Normal")
    };
    var (categoryIcon, categoryLabel) = Model.Category switch
    {
        ReportCategory.Fire => ("ph-fire", "Fire"),
        ReportCategory.Collapse => ("ph-house-line", "Collapse"),
        ReportCategory.Medical => ("ph-first-aid-kit", "Medical"),
        ReportCategory.Flood => ("ph-waves", "Flood"),
        _ => ("ph-question", "Unclassified")
    };
}
<span class="inline-flex items-center gap-2.5">
    <span class="@priorityClass text-xs font-bold px-2 py-0.5 rounded-sm">@priorityLabel</span>
    <span class="inline-flex items-center gap-1 text-sm font-semibold text-ink">
        <i class="ph @categoryIcon text-base text-primary" aria-hidden="true"></i>@categoryLabel
    </span>
</span>
