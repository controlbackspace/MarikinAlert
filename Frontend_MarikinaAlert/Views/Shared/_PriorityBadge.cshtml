@model DisasterReport
@{
    var (priorityClass, priorityLabel) = Model.Priority switch
    {
        ReportPriority.Critical => ("bg-danger text-white", "Critical"),
        ReportPriority.High => ("bg-accent text-ink", "High"),
        _ => ("bg-white text-muted border border-line", "Normal")
    };
    var categoryLabel = Model.Category.ToString();
}
<span class="inline-flex items-center gap-2.5">
    <span class="@priorityClass text-xs font-bold px-2 py-0.5 rounded-sm">@priorityLabel</span>
    <span class="text-sm font-semibold text-ink">@categoryLabel</span>
</span>
