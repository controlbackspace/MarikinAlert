@* Shared <head> assets. Everything is served from wwwroot so the app works on the offline intranet. *@
<link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<script src="~/lib/tailwind/tailwind.js"></script>
<script>
    // Marikina theme. Keep in sync with the CSS variables in wwwroot/css/site.css.
    tailwind.config = {
        theme: {
            extend: {
                fontFamily: {
                    sans: ['"Public Sans"', 'system-ui', 'sans-serif'],
                    mono: ['"IBM Plex Mono"', 'ui-monospace', 'monospace']
                },
                colors: {
                    primary: { DEFAULT: '#0032a0', dark: '#002170' },
                    header: '#001845',
                    secondary: '#003D82',
                    accent: '#FF7300',
                    success: '#06A77D',
                    danger: '#D62828',
                    info: '#0077BE',
                    surface: '#F8F9FA',
                    ink: '#1A1A1A',
                    muted: '#666666',
                    line: '#DDE1E6'
                },
                keyframes: {
                    'flash': { '0%': { backgroundColor: '#FFF3E0' }, '100%': { backgroundColor: '#FFFFFF' } }
                },
                animation: {
                    'flash': 'flash 3s ease-out'
                }
            }
        }
    };
</script>
