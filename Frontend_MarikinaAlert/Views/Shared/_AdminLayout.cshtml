@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string NavClass(string name) => action == name
        ? "text-white bg-white/10"
        : "text-slate-400 hover:text-white hover:bg-white/5";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>@(ViewData["Title"] is string t ? $"{t} · Rescue Command" : "Rescue Command")</title>
    <partial name="_Assets" />
</head>
<body class="font-sans antialiased min-h-screen bg-grid">

    <header class="sticky top-0 z-40 bg-panel/95 backdrop-blur border-b border-white/10">
        <div class="max-w-6xl mx-auto px-4 h-16 flex items-center gap-3">
            <a asp-controller="Admin" asp-action="Dashboard" class="flex items-center gap-3 mr-auto min-w-0">
                <span class="w-9 h-9 shrink-0 rounded-lg bg-red-500/15 border border-red-500/40 grid place-items-center">
                    <i class="ph-fill ph-siren text-xl text-red-400" aria-hidden="true"></i>
                </span>
                <span class="leading-tight min-w-0">
                    <span class="block font-extrabold tracking-[.18em] text-sm">RESCUE COMMAND</span>
                    <span class="hidden sm:block text-[11px] text-slate-400 uppercase tracking-wider">MarikinAlert dispatcher</span>
                </span>
            </a>

            <nav class="flex items-center gap-1" aria-label="Admin">
                <a asp-controller="Admin" asp-action="Dashboard" class="@NavClass("Dashboard") flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-bold transition" aria-current="@(action == "Dashboard" ? "page" : null)">
                    <i class="ph ph-broadcast text-lg" aria-hidden="true"></i><span class="hidden sm:inline">Live</span>
                </a>
                <a asp-controller="Admin" asp-action="History" class="@NavClass("History") flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-bold transition" aria-current="@(action == "History" ? "page" : null)">
                    <i class="ph ph-clock-counter-clockwise text-lg" aria-hidden="true"></i><span class="hidden sm:inline">History</span>
                </a>
            </nav>

            <div class="hidden md:block text-right leading-tight pl-3 border-l border-white/10">
                <span class="block text-sm font-bold">@User.Identity?.Name</span>
                <span class="block text-[11px] text-slate-400">On duty</span>
            </div>

            <form asp-controller="Admin" asp-action="Logout" method="post">
                <button type="submit" class="w-10 h-10 grid place-items-center rounded-lg bg-white/5 hover:bg-red-500/20 hover:text-red-300 text-slate-300 transition" title="Log out" aria-label="Log out">
                    <i class="ph ph-sign-out text-xl" aria-hidden="true"></i>
                </button>
            </form>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-8">
        @RenderBody()
    </main>

    <div id="toast" role="status" aria-live="polite"
         class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 px-4 py-3 rounded-xl bg-slate-800 border border-white/10 shadow-2xl text-sm font-semibold opacity-0 pointer-events-none transition-opacity"></div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
