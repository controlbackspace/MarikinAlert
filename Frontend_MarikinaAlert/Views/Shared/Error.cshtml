@model ErrorViewModel
@{
    var notFound = Model.StatusCode == 404;
    ViewData["Title"] = notFound ? "Page not found" : "Something went wrong";
}

<h1 class="text-[1.75rem] font-bold tracking-tight">@ViewData["Title"]</h1>
<p class="text-muted mt-2 max-w-prose">
    @(notFound ? "We couldn't find that page." : "The system hit a problem while handling your request.")
    If this is an emergency, use the report form or call <a href="tel:161" class="font-semibold text-primary underline">Rescue 161</a>.
</p>
<a asp-controller="Reports" asp-action="Create" class="mt-7 inline-flex items-center gap-2 rounded-md bg-danger hover:bg-[#B71F1F] text-white font-bold px-5 py-3.5">
    <i class="ph-fill ph-siren text-xl" aria-hidden="true"></i> Report an emergency
</a>
@if (Model.ShowRequestId && !notFound)
{
    <p class="mt-6 text-[13px] text-muted">Request ID: <code class="font-mono">@Model.RequestId</code></p>
}
