@model ErrorViewModel
@{
    var notFound = Model.StatusCode == 404;
    ViewData["Title"] = notFound ? "Page not found" : "Something went wrong";
}

<div class="text-center pt-10 animate-fade-in-up">
    <i class="ph @(notFound ? "ph-map-trifold" : "ph-warning-circle") text-6xl text-emerald-400" aria-hidden="true"></i>
    <h1 class="text-2xl font-extrabold mt-4">@ViewData["Title"]</h1>
    <p class="text-slate-300 mt-2">
        @(notFound ? "We couldn't find that page." : "The system hit a problem while handling your request.")
        If this is an emergency, use the report form or call <a href="tel:161" class="font-bold text-white underline">Rescue 161</a>.
    </p>
    <a asp-controller="Reports" asp-action="Create" class="mt-8 inline-flex items-center gap-2 rounded-2xl bg-emerald-500 text-ink font-extrabold px-6 py-4">
        <i class="ph-fill ph-siren text-xl" aria-hidden="true"></i> Go to report form
    </a>
    @if (Model.ShowRequestId && !notFound)
    {
        <p class="mt-6 text-xs text-slate-500">Request ID: <code>@Model.RequestId</code></p>
    }
</div>
