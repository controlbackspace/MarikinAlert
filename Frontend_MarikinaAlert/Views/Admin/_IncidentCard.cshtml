@model DisasterReport
@{
    var accent = Model.Priority switch
    {
        ReportPriority.Critical => "border-l-red-500",
        ReportPriority.High => "border-l-amber-400",
        _ => "border-l-slate-500"
    };
    var reference = $"MA-{Model.Id:D5}";
    var local = Marikina.ToLocal(Model.CreatedAtUtc);
    var summary =
        $"[MarikinAlert {reference}] {Model.Priority.ToString().ToUpperInvariant()} - {Model.Category.ToString().ToUpperInvariant()}\n" +
        $"Location: {Model.LocationText}, Marikina City\n" +
        $"Report: \"{Model.RawMessage}\"\n" +
        $"Reported: {local:MMM d, h:mm tt}" +
        (Model.SenderName is null && Model.ContactNumber is null ? "" : $" by {Model.SenderName ?? "resident"}{(Model.ContactNumber is null ? "" : $" ({Model.ContactNumber})")}");
}
<article data-id="@Model.Id" data-priority="@Model.Priority" class="incident rounded-xl bg-panel border border-white/10 border-l-4 @accent p-5 shadow-lg">
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="flex flex-wrap items-center gap-1.5">
            <partial name="_PriorityBadge" model="Model" />
            <partial name="_StatusBadge" model="Model" />
        </div>
        <div class="text-right text-xs text-slate-400 font-mono">
            <time datetime="@Model.CreatedAtUtc.ToString("o")" title="@local.ToString("MMMM d, yyyy h:mm tt")">@Marikina.TimeAgo(Model.CreatedAtUtc)</time>
            <span class="block text-slate-500">@reference</span>
        </div>
    </div>

    <h3 class="mt-3 text-lg font-extrabold leading-snug flex items-start gap-2">
        <i class="ph-fill ph-map-pin text-emerald-400 mt-1 shrink-0" aria-hidden="true"></i>
        <span>@Model.LocationText</span>
    </h3>
    <p class="mt-2 text-slate-200 leading-relaxed break-words">&ldquo;@Model.RawMessage&rdquo;</p>

    @if (Model.MatchedKeywords is not null)
    {
        <p class="mt-2 text-xs text-slate-400">Flagged for: <span class="text-slate-300 font-semibold">@Model.MatchedKeywords</span></p>
    }
    @if (Model.RelayedTo is not null)
    {
        <p class="mt-2 text-xs text-violet-300 font-semibold flex items-center gap-1"><i class="ph ph-paper-plane-tilt" aria-hidden="true"></i> Relayed to @Model.RelayedTo</p>
    }

    <div class="mt-4 pt-4 border-t border-white/10 flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-300">
            <span class="flex items-center gap-1.5"><i class="ph ph-user text-slate-400" aria-hidden="true"></i>@(Model.SenderName ?? "Anonymous")</span>
            @if (Model.ContactNumber is not null)
            {
                <a href="tel:@Model.ContactNumber" class="flex items-center gap-1.5 font-mono hover:text-emerald-300"><i class="ph ph-phone text-slate-400" aria-hidden="true"></i>@Model.ContactNumber</a>
            }
        </div>

        <div class="flex flex-wrap gap-2">
            @if (!Model.IsVerified)
            {
                <form asp-action="Verify" asp-route-id="@Model.Id" method="post" data-ajax data-done="Marked as verified">
                    <button class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-ink text-sm font-bold px-3 py-2 transition">
                        <i class="ph ph-seal-check text-base" aria-hidden="true"></i>Verify
                    </button>
                </form>
            }
            <button type="button" data-relay="@Model.Id" data-agency="@Marikina.SuggestedAgency(Model.Category)" data-summary="@summary"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-sky-400/40 bg-sky-400/10 text-sky-200 hover:bg-sky-400/20 text-sm font-bold px-3 py-2 transition">
                <i class="ph ph-paper-plane-tilt text-base" aria-hidden="true"></i>@(Model.RelayedTo is null ? "Relay to agency" : "Relay again")
            </button>
            <form asp-action="Resolve" asp-route-id="@Model.Id" method="post" data-ajax data-done="Moved to History as resolved">
                <button class="inline-flex items-center gap-1.5 rounded-lg border border-white/15 hover:bg-white/10 text-sm font-bold px-3 py-2 transition">
                    <i class="ph ph-check-circle text-base" aria-hidden="true"></i>Resolve
                </button>
            </form>
            <form asp-action="Dismiss" asp-route-id="@Model.Id" method="post" data-ajax data-done="Archived as noise" data-confirm="Archive @reference as noise / false alarm? It will move to History.">
                <button class="inline-flex items-center gap-1.5 rounded-lg border border-amber-400/30 text-amber-200 hover:bg-amber-400/10 text-sm font-bold px-3 py-2 transition">
                    <i class="ph ph-archive text-base" aria-hidden="true"></i>Archive as noise
                </button>
            </form>
        </div>
    </div>
</article>
