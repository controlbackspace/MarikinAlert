@model DisasterReport
@{
    var accent = Model.Priority switch
    {
        ReportPriority.Critical => "border-l-danger",
        ReportPriority.High => "border-l-accent",
        _ => "border-l-line"
    };
    var reference = $"MA-{Model.Id:D5}";
    var local = Marikina.ToLocal(Model.CreatedAtUtc);
    var summary =
        $"[MarikinAlert {reference}] {Model.Priority.ToString().ToUpperInvariant()} - {Model.Category.ToString().ToUpperInvariant()}\n" +
        $"Location: {Model.LocationText}, Marikina City\n" +
        $"Report: \"{Model.RawMessage}\"\n" +
        $"Reported: {local:MMM d, h:mm tt}" + (Model.Source == ReportSource.App ? "" : $" via {Model.SourceText}") +
        (Model.SenderName is null && Model.ContactNumber is null ? "" : $" by {Model.SenderName ?? (Model.Source == ReportSource.App ? "resident" : "caller")}{(Model.ContactNumber is null ? "" : $" ({Model.ContactNumber})")}");

    // Hints from IncidentInsights, passed in by _IncidentFeed.
    var overdue = ViewData["Overdue"] as bool? == true;
    var duplicateOf = ViewData["DuplicateOf"] as int?;
    var waitingMinutes = (int)(DateTime.UtcNow - Model.CreatedAtUtc).TotalMinutes;
    var agency = ViewData["Agency"] as Agency;
    var contacts = ViewData["Contacts"] as List<ContactAttempt> ?? new List<ContactAttempt>();
    var teams = ViewData["Teams"] as List<ResponseTeam> ?? new List<ResponseTeam>();
    var freeTeams = ViewData["FreeTeams"] as IReadOnlyList<ResponseTeam> ?? Array.Empty<ResponseTeam>();
    var anyTeams = ViewData["AnyTeams"] as bool? == true;
}
<article id="incident-@Model.Id" data-id="@Model.Id" data-priority="@Model.Priority"
         class="incident scroll-mt-20 bg-white border border-l-[5px] @accent rounded-md @(overdue ? "border-danger shadow-[0_0_0_1px_#D62828]" : "border-line")">
    @if (overdue)
    {
        <p class="px-5 py-2 bg-danger text-white text-sm font-bold rounded-tr-[5px]">
            Waiting @waitingMinutes min · not yet handled
        </p>
    }
    @if (duplicateOf is int originalId)
    {
        <p class="px-5 py-2 bg-surface border-b border-line text-sm">
            <span class="font-semibold">Possible duplicate</span> of
            <a href="#incident-@originalId" class="font-mono text-[13px] text-primary underline underline-offset-2">MA-@originalId.ToString("D5")</a>.
            Same barangay and type, reported within @IncidentInsights.DuplicateWindow.TotalMinutes min.
        </p>
    }
    <div class="px-5 pt-4 pb-4">
        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                <partial name="_PriorityBadge" model="Model" />
                <partial name="_StatusBadge" model="Model" />
            </div>
            <div class="text-sm text-muted">
                <time datetime="@Model.CreatedAtUtc.ToString("o")" title="@local.ToString("MMMM d, yyyy h:mm tt")">@Marikina.TimeAgo(Model.CreatedAtUtc)</time>
                <span class="font-mono text-[13px] ml-2">@reference</span>
            </div>
        </div>

        <h3 class="mt-2.5 text-lg font-bold leading-snug">@Model.LocationText</h3>
        <p class="mt-1 text-[15px] leading-relaxed break-words max-w-3xl">&ldquo;@Model.RawMessage&rdquo;</p>

        <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted">
            @if (Model.Source != ReportSource.App)
            {
                <span class="text-ink font-semibold">Logged by @(Model.LoggedBy ?? "a dispatcher") via @Model.SourceText</span>
            }
            <span>@(Model.SenderName ?? "No name given")</span>
            @if (Model.ContactNumber is not null)
            {
                <a href="tel:@Model.ContactNumber" class="font-mono text-[13px] text-primary hover:underline">@Model.ContactNumber</a>
            }
            @if (Model.MatchedKeywords is not null)
            {
                <span>Flagged for <span class="text-ink">@Model.MatchedKeywords</span></span>
            }
            @if (Model.RelayedTo is not null)
            {
                <span class="text-primary font-semibold">Relayed to @Model.RelayedTo</span>
            }
        </div>

        @if (contacts.Count > 0)
        {
            <ol class="mt-3 border-l-2 border-line pl-3 space-y-0.5 text-sm" aria-label="Contact log">
                @foreach (var c in contacts)
                {
                    <li>
                        <time class="font-mono text-[13px] text-muted" datetime="@c.AtUtc.ToString("o")">@Marikina.ToLocal(c.AtUtc).ToString("h:mm tt")</time>
                        <span class="font-semibold">@c.AgencyName</span>
                        @if (c.Number is not null)
                        {
                            <span class="font-mono text-[13px] text-muted">@c.Number</span>
                        }
                        · <span class="@(c.Outcome == ContactOutcome.Answered ? "text-success font-semibold" : "text-danger")">@c.OutcomeText</span>
                        @if (c.LoggedBy is not null)
                        {
                            <span class="text-muted">· @c.LoggedBy</span>
                        }
                    </li>
                }
            </ol>
        }

        @if (teams.Count > 0)
        {
            <ul class="mt-3 space-y-1.5" aria-label="Teams on this report">
                @foreach (var t in teams)
                {
                    <li class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                        <span class="font-semibold">@t.Name</span>
                        <span class="text-muted">@t.AgencyName@(t.CallSign is null ? "" : $" · {t.CallSign}")</span>
                        <partial name="_TeamBadge" model="t" />
                        @if (t.StatusChangedAtUtc is DateTime since)
                        {
                            <span class="text-muted">@Marikina.TimeAgo(since)</span>
                        }
                        <span class="flex gap-1"><partial name="_TeamActions" model="t" /></span>
                    </li>
                }
            </ul>
        }

        @if (freeTeams.Count > 0)
        {
            @* Best match first: the agency that should respond, then the closest base on the map. *@
            <form asp-action="AssignTeam" asp-route-id="@Model.Id" method="post" data-ajax data-done="Team dispatched"
                  data-conflict="That team was just sent somewhere else. Pick another." class="mt-3 flex items-center gap-2">
                <label class="text-sm font-semibold" for="team-@Model.Id">Send a team</label>
                <span class="flex">
                    <select id="team-@Model.Id" name="teamId" class="rounded-l-md border border-r-0 border-line bg-white text-sm px-2 py-[5px] max-w-[15rem]">
                        @foreach (var t in freeTeams)
                        {
                            <option value="@t.Id">@t.Name (@(Marikina.Map.GetValueOrDefault(t.BaseBarangay)?.Label ?? t.BaseBarangay))</option>
                        }
                    </select>
                    <button class="rounded-r-md bg-primary hover:bg-primary-dark text-white text-sm font-semibold px-3 py-1.5 transition active:translate-y-px whitespace-nowrap">Send</button>
                </span>
            </form>
        }
        else if (anyTeams)
        {
            <p class="mt-3 text-sm text-muted">No free teams to send right now.</p>
        }
    </div>

    <div class="px-5 py-3 border-t border-line bg-surface/60 flex flex-wrap items-center gap-2">
        @if (!Model.IsVerified)
        {
            <form asp-action="Verify" asp-route-id="@Model.Id" method="post" data-ajax data-done="Marked as verified">
                <button class="rounded-md bg-primary hover:bg-primary-dark text-white text-sm font-semibold px-3.5 py-2 transition active:translate-y-px">Verify</button>
            </form>
        }
        <button type="button" data-relay="@Model.Id" data-agency="@Marikina.SuggestedAgency(Model.Category)" data-summary="@summary"
                class="rounded-md border border-primary text-primary hover:bg-primary/5 text-sm font-semibold px-3.5 py-[7px] transition active:translate-y-px">
            @(Model.RelayedTo is null ? "Relay to agency" : "Relay again")
        </button>
        @if (agency?.Hotline is string hotline)
        {
            @* The link dials on a phone; admin.js also opens the relay dialog so the outcome gets logged. *@
            <a href="@Agency.TelHref(hotline)" data-call="@Model.Id" data-agency="@agency.Name" data-number="@hotline" data-summary="@summary"
               title="Call @agency.Name" aria-label="Call @agency.Name at @hotline"
               class="rounded-md bg-[#05795B] hover:bg-[#04634A] text-white text-sm font-semibold px-3.5 py-2 transition active:translate-y-px whitespace-nowrap">
                Call <span class="font-mono text-[13px] font-medium">@hotline</span>
            </a>
        }
        <form asp-action="Resolve" asp-route-id="@Model.Id" method="post" data-ajax data-done="Moved to History as resolved">
            <button class="rounded-md text-sm font-semibold text-ink hover:bg-black/5 px-3 py-2 transition">Resolve</button>
        </form>
        <form asp-action="Dismiss" asp-route-id="@Model.Id" method="post" data-ajax data-done="Archived as noise" data-confirm="Archive @reference as noise / false alarm? It will move to History." class="ml-auto">
            <button class="rounded-md text-sm font-semibold text-muted hover:text-danger hover:bg-danger/5 px-3 py-2 transition">Archive as noise</button>
        </form>
    </div>
</article>
