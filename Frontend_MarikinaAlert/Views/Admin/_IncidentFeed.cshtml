@model IncidentFeedViewModel
<div id="feed-data" data-critical="@Model.CriticalCount" data-open="@Model.OpenCount" data-overdue="@Model.OverdueIds.Count" class="space-y-3">
    @if (Model.Reports.Count == 0)
    {
        <div class="bg-white border border-line rounded-md px-6 py-12 text-center">
            <p class="text-lg font-bold">@(Model.Category is null && Model.Status is null ? "No open incidents" : "Nothing matches these filters")</p>
            <p class="text-muted mt-1">New reports appear here on their own. You don't need to refresh.</p>
        </div>
    }
    else
    {
        @foreach (var report in Model.Reports)
        {
            var hints = new ViewDataDictionary(ViewData)
            {
                ["Overdue"] = Model.OverdueIds.Contains(report.Id),
                ["DuplicateOf"] = Model.DuplicateOf.TryGetValue(report.Id, out var originalId) ? originalId : (int?)null
            };
            <partial name="_IncidentCard" model="report" view-data="hints" />
        }
    }
</div>
