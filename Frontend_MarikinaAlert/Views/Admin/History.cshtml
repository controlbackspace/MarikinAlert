@model HistoryViewModel
@{
    ViewData["Title"] = "History";
    Layout = "_AdminLayout";
}

<h1 class="text-2xl font-bold tracking-tight">History</h1>
<p class="text-sm text-muted mt-1">Resolved reports and reports archived as noise.</p>

<form asp-action="History" method="get" class="mt-6 mb-4 flex flex-wrap items-end gap-3">
    <label class="flex-1 min-w-[14rem] text-sm font-semibold">
        <span class="block mb-1">Search</span>
        <input type="search" name="q" value="@Model.Search" placeholder="Message, barangay, landmark or name"
               class="field !min-h-0 !py-2 text-[15px]" />
    </label>
    <label class="text-sm font-semibold">
        <span class="block mb-1">Status</span>
        <select name="status" onchange="this.form.submit()" class="field !min-h-0 !py-2 w-40 text-[15px]">
            <option value="">All</option>
            <option value="Resolved" selected="@(Model.Status == ReportStatus.Resolved)">Resolved</option>
            <option value="Dismissed" selected="@(Model.Status == ReportStatus.Dismissed)">Dismissed</option>
        </select>
    </label>
    <button class="rounded-md bg-primary hover:bg-primary-dark text-white px-4 py-2 text-sm font-semibold">Search</button>
</form>

@if (Model.Reports.Count == 0)
{
    <div class="bg-white border border-line rounded-md px-6 py-12 text-center">
        <p class="text-lg font-bold">@(string.IsNullOrWhiteSpace(Model.Search) && Model.Status is null ? "No closed incidents yet" : "No incidents match your search")</p>
        <p class="text-muted mt-1">Reports you resolve or archive on the live page end up here.</p>
    </div>
}
else
{
    <ul class="bg-white border border-line rounded-md divide-y divide-line">
        @foreach (var r in Model.Reports)
        {
            var closed = Marikina.ToLocal(r.UpdatedAtUtc ?? r.CreatedAtUtc);
            <li class="px-5 py-4 flex flex-wrap items-center gap-x-6 gap-y-3">
                <div class="flex-1 min-w-[16rem]">
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                        <partial name="_PriorityBadge" model="r" />
                        <partial name="_StatusBadge" model="r" />
                        <span class="font-mono text-[13px] text-muted">MA-@r.Id.ToString("D5")</span>
                    </div>
                    <p class="mt-1.5 font-semibold">@r.LocationText</p>
                    <p class="text-[15px] text-muted line-clamp-2 break-words max-w-3xl">&ldquo;@r.RawMessage&rdquo;</p>
                    <p class="text-[13px] text-muted mt-1">
                        Reported @Marikina.ToLocal(r.CreatedAtUtc).ToString("MMM d, h:mm tt") · Closed @closed.ToString("MMM d, h:mm tt")
                        @if (r.RelayedTo is not null) { <text>· Relayed to @r.RelayedTo</text> }
                        @if (r.Source != ReportSource.App) { <text>· Logged by @(r.LoggedBy ?? "a dispatcher") via @r.SourceText</text> }
                    </p>
                </div>
                <form asp-action="Reopen" asp-route-id="@r.Id" method="post">
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button class="rounded-md border border-line hover:border-primary hover:text-primary text-sm font-semibold px-3.5 py-2 transition">Reopen</button>
                </form>
            </li>
        }
    </ul>
}
