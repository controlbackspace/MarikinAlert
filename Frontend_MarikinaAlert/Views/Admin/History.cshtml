@model HistoryViewModel
@{
    ViewData["Title"] = "Incident History";
    Layout = "_AdminLayout";
}

<div class="flex flex-wrap items-end justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-extrabold">Incident History</h1>
        <p class="text-sm text-slate-400 mt-1">Resolved reports and reports archived as noise.</p>
    </div>
</div>

<form asp-action="History" method="get" class="flex flex-wrap items-center gap-3 mb-6 rounded-xl border border-white/10 bg-panel/80 p-3">
    <label class="relative flex-1 min-w-[12rem]">
        <span class="sr-only">Search</span>
        <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" aria-hidden="true"></i>
        <input type="search" name="q" value="@Model.Search" placeholder="Search message, barangay, landmark, name"
               class="w-full rounded-lg bg-ink border border-white/15 pl-9 pr-3 py-2 text-sm font-semibold placeholder:text-slate-500" />
    </label>
    <select name="status" onchange="this.form.submit()" aria-label="Status" class="rounded-lg bg-ink border border-white/15 px-3 py-2 text-sm font-semibold">
        <option value="">All</option>
        <option value="Resolved" selected="@(Model.Status == ReportStatus.Resolved)">Resolved</option>
        <option value="Dismissed" selected="@(Model.Status == ReportStatus.Dismissed)">Dismissed</option>
    </select>
    <button class="rounded-lg bg-white/10 hover:bg-white/15 px-4 py-2 text-sm font-bold">Search</button>
</form>

@if (Model.Reports.Count == 0)
{
    <div class="rounded-xl border border-dashed border-white/15 bg-panel/60 p-10 text-center">
        <i class="ph ph-archive text-4xl text-slate-500" aria-hidden="true"></i>
        <p class="mt-3 font-bold">@(string.IsNullOrWhiteSpace(Model.Search) && Model.Status is null ? "No closed incidents yet" : "No incidents match your search")</p>
    </div>
}
else
{
    <ul class="space-y-2">
        @foreach (var r in Model.Reports)
        {
            var closed = Marikina.ToLocal(r.UpdatedAtUtc ?? r.CreatedAtUtc);
            <li class="rounded-xl border border-white/10 bg-panel/80 p-4 flex flex-wrap items-center gap-4">
                <div class="flex-1 min-w-[14rem]">
                    <div class="flex flex-wrap items-center gap-1.5">
                        <partial name="_PriorityBadge" model="r" />
                        <partial name="_StatusBadge" model="r" />
                        <span class="text-xs font-mono text-slate-500 ml-1">MA-@r.Id.ToString("D5")</span>
                    </div>
                    <p class="mt-2 font-bold">@r.LocationText</p>
                    <p class="text-sm text-slate-300 line-clamp-2 break-words">&ldquo;@r.RawMessage&rdquo;</p>
                    <p class="text-xs text-slate-400 mt-1">
                        Reported @Marikina.ToLocal(r.CreatedAtUtc).ToString("MMM d, h:mm tt") · Closed @closed.ToString("MMM d, h:mm tt")
                        @if (r.RelayedTo is not null) { <text>· Relayed to @r.RelayedTo</text> }
                    </p>
                </div>
                <form asp-action="Reopen" asp-route-id="@r.Id" method="post">
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button class="inline-flex items-center gap-1.5 rounded-lg border border-white/15 hover:bg-white/10 text-sm font-bold px-3 py-2">
                        <i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i>Reopen
                    </button>
                </form>
            </li>
        }
    </ul>
}
