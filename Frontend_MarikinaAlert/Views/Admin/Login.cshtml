@model LoginViewModel
@{
    ViewData["Title"] = "Dispatcher login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Dispatcher login · MarikinAlert</title>
    <partial name="_Assets" />
</head>
<body class="font-sans antialiased min-h-[100dvh] bg-surface flex flex-col">

    <header class="bg-header text-white">
        <div class="max-w-6xl mx-auto px-4 h-14 flex items-center gap-2.5">
            <svg viewBox="0 0 32 32" class="w-7 h-7" aria-hidden="true"><rect width="32" height="32" rx="6" fill="#fff"/><path d="M8 23V9l8 8 8-8v14" fill="none" stroke="#0032a0" stroke-width="3.2" stroke-linejoin="round" stroke-linecap="round"/><rect x="6" y="26" width="20" height="2.5" rx="1" fill="#F77F00"/></svg>
            <span class="font-bold tracking-tight">MarikinAlert <span class="font-normal text-white/70">Dispatch</span></span>
        </div>
    </header>
    <div class="h-1 bg-accent" aria-hidden="true"></div>

    <main class="flex-1 px-4 py-12 sm:py-16">
        <div class="w-full max-w-sm mx-auto">
            <h1 class="text-2xl font-bold tracking-tight">Dispatcher login</h1>
            <p class="text-muted mt-1">For MCDRRMO triage officers and dispatchers.</p>

            <form asp-action="Login" method="post" class="mt-7 bg-white border border-line rounded-lg p-6 space-y-5" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="border-l-4 border-danger bg-danger/5 text-danger text-sm font-semibold px-3 py-2.5"></div>

                <div>
                    <label asp-for="Username" class="block font-semibold mb-1.5"></label>
                    <input asp-for="Username" autocomplete="username" autofocus class="field" />
                    <span asp-validation-for="Username"></span>
                </div>

                <div>
                    <label asp-for="Password" class="block font-semibold mb-1.5"></label>
                    <div class="relative">
                        <input asp-for="Password" autocomplete="current-password" class="field pr-20" />
                        <button type="button" id="toggle-password" class="absolute right-1.5 top-1/2 -translate-y-1/2 px-2.5 py-1.5 text-sm font-semibold text-primary hover:underline" aria-pressed="false">Show</button>
                    </div>
                    <span asp-validation-for="Password"></span>
                </div>

                <button type="submit" class="w-full rounded-md bg-primary hover:bg-primary-dark text-white font-bold py-3 transition active:translate-y-px">Log in</button>
            </form>

            <a asp-controller="Reports" asp-action="Create" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline underline-offset-4">
                <i class="ph ph-arrow-left" aria-hidden="true"></i> Back to the resident report form
            </a>
        </div>
    </main>

    <script>
        document.getElementById('toggle-password').addEventListener('click', function () {
            const input = document.getElementById('Password');
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            this.setAttribute('aria-pressed', show);
            this.textContent = show ? 'Hide' : 'Show';
        });
    </script>
</body>
</html>
