@model IncidentFeedViewModel
@{
    ViewData["Title"] = "Live incidents";
    Layout = "_AdminLayout";
}

@if (TempData["LoggedRef"] is string loggedRef)
{
    <div class="mb-6 border-l-4 border-success bg-white border border-line rounded-md px-5 py-3.5 flex flex-wrap items-baseline gap-x-6 gap-y-1" role="status">
        <p class="font-semibold">Report @loggedRef added to live incidents.</p>
        @if (TempData["LoggedCode"] is string loggedCode)
        {
            <p class="text-sm text-muted">Tracking code for the caller: <span class="font-mono text-base text-ink tracking-wider select-all">@loggedCode</span></p>
        }
    </div>
}

<div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
    <div>
        <h1 class="text-2xl font-bold tracking-tight">Live incidents</h1>
        <p class="text-sm text-muted mt-1 flex items-center gap-2">
            <span id="live-dot" class="w-2 h-2 rounded-full bg-success" aria-hidden="true"></span>
            <span id="live-status">Updating automatically</span>
        </p>
    </div>

    <dl class="flex items-stretch divide-x divide-line bg-white border border-line rounded-md">
        <div class="px-4 py-2">
            <dt class="text-xs text-muted">Critical</dt>
            <dd id="critical-count" class="text-xl font-bold text-danger tabular-nums leading-tight">@Model.CriticalCount</dd>
        </div>
        <div class="px-4 py-2">
            <dt class="text-xs text-muted">Open</dt>
            <dd id="open-count" class="text-xl font-bold tabular-nums leading-tight">@Model.OpenCount</dd>
        </div>
        <div class="px-4 py-2" title="New reports not handled within 5 min (Critical) or 10 min (High)">
            <dt class="text-xs text-muted">Overdue</dt>
            <dd id="overdue-count" class="text-xl font-bold tabular-nums leading-tight @(Model.OverdueIds.Count > 0 ? "text-danger" : "")">@Model.OverdueIds.Count</dd>
        </div>
    </dl>
</div>

<form id="filters" asp-action="Dashboard" method="get" class="mt-6 mb-4 flex flex-wrap items-end gap-3">
    <input type="hidden" name="barangay" value="@Model.Barangay" />
    <label class="text-sm font-semibold">
        <span class="block mb-1">Category</span>
        <select name="category" class="field !min-h-0 !py-2 w-44 text-[15px]">
            <option value="">All categories</option>
            @foreach (var c in Enum.GetValues<ReportCategory>())
            {
                <option value="@c" selected="@(Model.Category == c)">@c</option>
            }
        </select>
    </label>
    <label class="text-sm font-semibold">
        <span class="block mb-1">Status</span>
        <select name="status" class="field !min-h-0 !py-2 w-40 text-[15px]">
            <option value="">All open</option>
            <option value="Active" selected="@(Model.Status == ReportStatus.Active)">New</option>
            <option value="Verified" selected="@(Model.Status == ReportStatus.Verified)">Verified</option>
            <option value="Relayed" selected="@(Model.Status == ReportStatus.Relayed)">Relayed</option>
        </select>
    </label>
    <noscript><button class="rounded-md bg-primary text-white px-3.5 py-2 text-sm font-semibold">Apply</button></noscript>
    <a asp-action="Dashboard" class="text-sm font-semibold text-primary hover:underline underline-offset-4 pb-2.5">Clear filters</a>

    <button type="button" id="sound-toggle" aria-pressed="false"
            class="ml-auto rounded-md border border-line bg-white px-3 py-2 text-sm font-semibold text-muted hover:text-ink">
        <span>Sound alerts off</span>
    </button>
</form>

<div id="feed" aria-live="polite">
    <partial name="_IncidentFeed" model="Model" />
</div>

@* Relay to agency *@
<dialog id="relay-dialog" class="w-[calc(100%-2rem)] max-w-lg rounded-lg bg-white text-ink p-0 shadow-[0_20px_50px_rgba(0,33,112,.25)]">
    <form asp-action="Relay" method="post" id="relay-form">
        <input type="hidden" name="id" />
        <div class="px-6 pt-5 pb-4 border-b border-line flex items-start justify-between gap-4">
            <div>
                <h2 class="text-lg font-bold">Relay to agency</h2>
                <p class="text-sm text-muted mt-0.5">Call or radio the agency, log how it went, then mark it as relayed.</p>
            </div>
            <button type="button" data-close class="-mr-2 rounded-md px-2.5 py-1.5 text-sm font-semibold text-muted hover:bg-black/5 hover:text-ink">Close</button>
        </div>

        <div class="px-6 py-5 space-y-4">
            <label class="block">
                <span class="block font-semibold mb-1.5">Agency</span>
                <select name="agency" class="field">
                    @foreach (var agency in Model.Agencies.Values.OrderBy(a => a.SortOrder).ThenBy(a => a.Name))
                    {
                        <option value="@agency.Name" data-hotline="@agency.Hotline" data-backup="@agency.BackupNumber" data-radio="@agency.RadioChannel">@agency.Name</option>
                    }
                </select>
            </label>

            @* Numbers come from the Agencies page. Calls go out on the dispatcher's own phone, which works without internet. *@
            <div class="rounded-md border border-line p-4">
                <p id="relay-no-contact" class="text-sm text-muted" hidden>
                    No number or radio channel saved for this agency.
                    <a asp-action="Agencies" class="font-semibold text-primary underline underline-offset-2">Add one on the Agencies page</a>.
                </p>
                <div id="relay-numbers" class="flex flex-wrap items-center gap-2">
                    <a id="call-hotline" data-dial class="rounded-md bg-[#05795B] hover:bg-[#04634A] text-white font-semibold px-4 py-2.5 transition active:translate-y-px">
                        Call <span class="font-mono font-medium"></span>
                    </a>
                    <a id="call-backup" data-dial class="rounded-md border border-[#05795B] text-[#05795B] hover:bg-[#05795B]/5 font-semibold px-4 py-[9px] transition active:translate-y-px">
                        Backup <span class="font-mono font-medium"></span>
                    </a>
                    <span id="relay-radio" class="text-sm text-muted">Radio <strong class="text-ink"></strong></span>
                </div>
                <fieldset id="relay-log" class="mt-4">
                    <legend class="text-sm font-semibold">Log the result</legend>
                    <div class="mt-1.5 flex flex-wrap gap-2">
                        <button type="button" data-method="Phone" data-outcome="Answered" class="rounded-md border border-line bg-white hover:border-success hover:text-success text-sm font-semibold px-3 py-1.5">Answered</button>
                        <button type="button" data-method="Phone" data-outcome="NoAnswer" class="rounded-md border border-line bg-white hover:border-danger hover:text-danger text-sm font-semibold px-3 py-1.5">No answer</button>
                        <button type="button" data-method="Phone" data-outcome="Busy" class="rounded-md border border-line bg-white hover:border-danger hover:text-danger text-sm font-semibold px-3 py-1.5">Busy / can't connect</button>
                        <button type="button" data-method="Radio" data-outcome="Answered" class="rounded-md border border-line bg-white hover:border-success hover:text-success text-sm font-semibold px-3 py-1.5">Reached by radio</button>
                    </div>
                </fieldset>
            </div>

            <label class="block">
                <span class="block font-semibold mb-1.5">Details to relay</span>
                <textarea id="relay-summary" rows="6" readonly class="field font-mono text-[13px] leading-relaxed resize-none bg-surface"></textarea>
            </label>
        </div>

        <div class="px-6 py-4 border-t border-line bg-surface flex flex-wrap justify-end gap-2 rounded-b-lg">
            <button type="button" id="copy-summary" class="rounded-md border border-line bg-white hover:bg-black/[.03] font-semibold px-4 py-2.5">
                <span>Copy details</span>
            </button>
            <button type="submit" class="rounded-md bg-primary hover:bg-primary-dark text-white font-semibold px-4 py-2.5">Mark as relayed</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
