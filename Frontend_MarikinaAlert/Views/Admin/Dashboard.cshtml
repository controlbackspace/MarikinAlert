@model IncidentFeedViewModel
@{
    ViewData["Title"] = "Live Incidents";
    Layout = "_AdminLayout";
}

<div class="flex flex-wrap items-end justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-extrabold">Live Incidents</h1>
        <p class="text-sm text-slate-400 mt-1 flex items-center gap-2">
            <span class="relative flex w-2 h-2" aria-hidden="true">
                <span id="live-ping" class="absolute inline-flex w-full h-full rounded-full bg-emerald-400 opacity-75 animate-ping"></span>
                <span id="live-dot" class="relative inline-flex w-2 h-2 rounded-full bg-emerald-400"></span>
            </span>
            <span id="live-status">Updating automatically</span>
        </p>
    </div>

    <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-2 rounded-full border border-red-500/40 bg-red-500/10 px-3 py-1.5 text-xs font-extrabold uppercase text-red-300">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse" aria-hidden="true"></span>
            <span id="critical-count">@Model.CriticalCount</span> critical
        </span>
        <span class="inline-flex items-center gap-2 rounded-full border border-white/15 px-3 py-1.5 text-xs font-extrabold uppercase text-slate-300">
            <span id="open-count">@Model.OpenCount</span> open
        </span>
        <button type="button" id="sound-toggle" aria-pressed="false" title="Play a sound when a new critical report arrives"
                class="inline-flex items-center gap-1.5 rounded-full border border-white/15 px-3 py-1.5 text-xs font-bold text-slate-300 hover:bg-white/5">
            <i class="ph ph-speaker-slash text-base" aria-hidden="true"></i><span>Sound off</span>
        </button>
    </div>
</div>

<form id="filters" asp-action="Dashboard" method="get" class="flex flex-wrap items-center gap-3 mb-6 rounded-xl border border-white/10 bg-panel/80 p-3">
    <label class="flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-slate-400">
        Category
        <select name="category" class="rounded-lg bg-ink border border-white/15 px-3 py-2 text-sm font-semibold text-white normal-case tracking-normal">
            <option value="">All categories</option>
            @foreach (var c in Enum.GetValues<ReportCategory>())
            {
                <option value="@c" selected="@(Model.Category == c)">@c</option>
            }
        </select>
    </label>
    <label class="flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-slate-400">
        Status
        <select name="status" class="rounded-lg bg-ink border border-white/15 px-3 py-2 text-sm font-semibold text-white normal-case tracking-normal">
            <option value="">All open</option>
            <option value="Active" selected="@(Model.Status == ReportStatus.Active)">New</option>
            <option value="Verified" selected="@(Model.Status == ReportStatus.Verified)">Verified</option>
            <option value="Relayed" selected="@(Model.Status == ReportStatus.Relayed)">Relayed</option>
        </select>
    </label>
    <noscript><button class="rounded-lg bg-white/10 px-3 py-2 text-sm font-bold">Apply</button></noscript>
    <a asp-action="Dashboard" class="text-sm font-semibold text-slate-400 hover:text-white ml-auto">Clear filters</a>
</form>

<div id="feed" aria-live="polite" aria-busy="false">
    <partial name="_IncidentFeed" model="Model" />
</div>

@* Relay to agency *@
<dialog id="relay-dialog" class="w-[calc(100%-2rem)] max-w-lg rounded-2xl border border-white/10 bg-panel text-white p-0 shadow-2xl">
    <form asp-action="Relay" method="post" id="relay-form" class="p-6 space-y-4">
        <input type="hidden" name="id" />
        <div class="flex items-start justify-between gap-4">
            <div>
                <h2 class="text-lg font-extrabold">Relay to agency</h2>
                <p class="text-sm text-slate-400">Copy the details, send them by radio or phone, then confirm.</p>
            </div>
            <button type="button" data-close class="w-9 h-9 grid place-items-center rounded-lg hover:bg-white/10 text-slate-400" aria-label="Close"><i class="ph ph-x text-xl" aria-hidden="true"></i></button>
        </div>

        <label class="block">
            <span class="block text-xs font-bold uppercase tracking-wide text-slate-400 mb-1.5">Agency</span>
            <select name="agency" class="w-full rounded-lg bg-ink border border-white/15 px-3 py-2.5 font-semibold">
                @foreach (var agency in Marikina.Agencies)
                {
                    <option value="@agency">@agency</option>
                }
            </select>
        </label>

        <label class="block">
            <span class="block text-xs font-bold uppercase tracking-wide text-slate-400 mb-1.5">Message to relay</span>
            <textarea id="relay-summary" rows="6" readonly class="w-full rounded-lg bg-ink border border-white/15 px-3 py-2.5 text-sm font-mono text-slate-200 resize-none"></textarea>
        </label>

        <div class="flex flex-wrap justify-end gap-2 pt-2">
            <button type="button" id="copy-summary" class="inline-flex items-center gap-1.5 rounded-lg border border-white/15 hover:bg-white/10 font-bold px-4 py-2.5">
                <i class="ph ph-copy" aria-hidden="true"></i><span>Copy details</span>
            </button>
            <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg bg-sky-500 hover:bg-sky-400 text-ink font-extrabold px-4 py-2.5">
                <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>Mark as relayed
            </button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
